{
  "expo": {
    "name": "goil-app",
    "slug": "goil-app",
    "version": "1.0.0",
    "scheme": "goilapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yoselorm.goil-app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "location"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Goil uses your location in the background to alert you when you're near a station.",
        "NSLocationWhenInUseUsageDescription": "Goil uses your location to show nearby stations and sort the station list by distance.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/goil-logo.png",
          "imageWidth": 160,
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Goil uses your location in the background to alert you when you're near a station."
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/goil-logo.png",
          "color": "#E11D2E"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bea34647-e021-4fe8-aa6d-e81a87c04b99"
      }
    },
    "owner": "yoselorm"
  }
}
